# Copy these lines into Streamlit Cloud: Manage app → ⋮ → Settings → Secrets.
# Never commit a real secrets.toml to GitHub.
[supabase]
url = "https://YOUR-PROJECT-ID.supabase.co"
key = "YOUR-PUBLISHABLE-OR-ANON-KEY"

# Optional: email alert when a business submits an ad (Gmail App Password, not your normal password)
[email]
gmail_address = "you@gmail.com"
app_password = "abcd efgh ijkl mnop"
send_to = "you@gmail.com"
